<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyTitle>SCP:SL Plugin Base</AssemblyTitle>
    <AssemblyDescription>A base plugin for SCP: Secret Laboratory using EXILED framework</AssemblyDescription>
    <AssemblyVersion>1.0.0</AssemblyVersion>
    <FileVersion>1.0.0</FileVersion>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="EXILED" Version="9.0.0-alpha.1" />
    <PackageReference Include="UnityEngine.CoreModule" Version="2020.3.1" />
  </ItemGroup>

</Project>
